{
  "contract": "dashboard-username-password-auth",
  "version": 1,
  "status": "design_only",
  "review": {
    "username_rule": "confirmed_by_user",
    "username_rule_summary": "3-32 ASCII characters, normalized to lowercase; first and last characters are alphanumeric; middle may contain dot, underscore, or hyphen"
  },
  "scope": "Part 0/1/2/4/5/6 shared browser session",
  "identity": {
    "supabase_native_identity": "email_password",
    "browser_login_field": "username",
    "mapping_table": "app_usernames",
    "canonicalization": [
      "trim",
      "unicode_nfkc",
      "ascii_lowercase",
      "reject_non_ascii"
    ],
    "minimum_length": 3,
    "maximum_length": 32,
    "pattern": "^[a-z0-9](?:[a-z0-9._-]{1,30}[a-z0-9])$",
    "username_mutable": false,
    "old_username_reuse": false,
    "public_signup": false,
    "rls_authority": "auth.uid()",
    "vps_admin_authority": "explicit_vps_admins_membership"
  },
  "edge_functions": {
    "login": {
      "method": "POST",
      "path": "/functions/v1/username-login",
      "request_fields": ["username", "password"],
      "success_status": 200,
      "failure_status": 401,
      "failure_code": "invalid_credentials",
      "enumeration_safe": true,
      "returns_internal_email": false,
      "returns_service_secrets": false
    },
    "recovery_request": {
      "method": "POST",
      "path": "/functions/v1/username-recovery-request",
      "request_fields": ["username"],
      "enumeration_safe": true,
      "returns_recovery_email": false
    }
  },
  "password": {
    "minimum_length": 12,
    "stored_by_browser": false,
    "stored_in_repository": false,
    "logged": false
  },
  "browser_session": {
    "persistSession": true,
    "autoRefreshToken": true,
    "detectSessionInUrl": false,
    "application_fixed_ttl": null,
    "restore_until": [
      "site_data_exists",
      "user_has_not_signed_out",
      "server_session_is_valid",
      "server_authorization_has_not_been_revoked"
    ],
    "logout_clears_private_memory": true,
    "logout_clears_private_dom": true,
    "logout_fallback_to_public_data": false
  },
  "rate_limit_default": {
    "composite_key": "ip_hash_and_username_hash",
    "failed_attempts_per_15_minutes": 5,
    "server_side": true,
    "raw_password_retained": false,
    "raw_ip_logged": false
  },
  "browser_allowed_secrets": [
    "supabase_project_url",
    "supabase_publishable_or_anon_key",
    "short_lived_auth_session_tokens"
  ],
  "browser_forbidden_secrets": [
    "service_role_key",
    "supabase_secret_key",
    "database_password",
    "jwt_secret",
    "github_pat",
    "vps_hmac_secret",
    "provider_api_key",
    "broker_or_trading_credentials"
  ],
  "cutover_gates": [
    "old_public_github_vault_path_removed",
    "anonymous_rls_probe_denied",
    "unauthorized_authenticated_rls_probe_denied",
    "authorized_authenticated_rls_probe_succeeds",
    "login_failure_messages_are_uniform",
    "session_restore_and_logout_verified",
    "recovery_path_verified_without_email_disclosure",
    "no_private_data_public_json_fallback"
  ]
}
